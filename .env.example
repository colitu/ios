# Copy to .env and fill in your own values. .env is gitignored.
# The iOS fastlane lane (ios/fastlane/Fastfile) reads these via ENV.fetch,
# so a missing variable fails fast instead of silently signing with the wrong
# identity.

# App Store Connect API key.
# The .p8 file goes at ios/fastlane/AuthKey.p8 (gitignored).
FASTLANE_ASC_KEY_ID=
FASTLANE_ASC_ISSUER_ID=

# Optional provisioning profile names (defaults shown).
COLITU_APP_PROFILE_SPECIFIER=ColituSecureVPNiOS
COLITU_TUN_PROFILE_SPECIFIER=ColituSecureVPNTun

# Colitu panel API, passed to Flutter as --dart-define=COLITU_API_BASE_URL=...
# (codemagic.yaml does this). Override only for staging builds.
COLITU_API_BASE_URL=https://api.colitu.com/api/v1
